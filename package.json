{
  "name": "atriveo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tailor": "node --env-file=.env.tailor scripts/tailor-server.mjs",
    "tailor:tunnel": "cloudflared tunnel --config scripts/cloudflared-tailor.yml run",
    "tailor:setup": "node scripts/setup-tailor-tunnel.mjs",
    "tailor:dns": "node scripts/tailor-dns.mjs",
    "tailor:prod": "node scripts/tailor-prod.mjs",
    "tailor:install": "node scripts/install-tailor-service.mjs",
    "tailor:check": "node scripts/check-tailor-relay.mjs",
    "tailor:restart": "node scripts/restart-tailor-service.mjs",
    "tailor:recover": "node scripts/tailor-recover.mjs",
    "tailor:doctor": "node scripts/tailor-doctor.mjs",
    "tailor:worker": "node --env-file=.env scripts/tailor-worker.mjs",
    "tailor:worker:once": "node --env-file=.env scripts/tailor-worker.mjs --once",
    "tailor:worker:install": "node scripts/install-tailor-worker-service.mjs",
    "tailor:worker:uninstall": "node scripts/uninstall-tailor-worker-service.mjs",
    "tailor:worker:restart": "node scripts/restart-tailor-worker-service.mjs",
    "resume:enqueue": "node --env-file=.env scripts/resume-enqueue.mjs",
    "tailor:uninstall": "node scripts/uninstall-tailor-service.mjs",
    "ac:benchmark": "node scripts/ac-benchmark.mjs",
    "ac:review": "node scripts/ac-compose-review.mjs",
    "ac:learn": "node scripts/ac-learning-report.mjs --recompute",
    "ac:market": "node scripts/ac-market.mjs",
    "ac:outcome": "node scripts/ac-outcome.mjs",
    "ac:pdf": "node scripts/ac-pdf.mjs",
    "ac:compose": "node scripts/ac-compose-review.mjs",
    "ac:golden": "node scripts/ac-golden.mjs",
    "ac:golden:update": "node scripts/ac-golden.mjs --update",
    "ac:bullet-lint": "node scripts/ac-bullet-lint.mjs",
    "ac:ats-enforce": "node scripts/ac-ats-enforce.mjs && node scripts/ac-ats-manual-fixes.mjs",
    "ac:ats-audit": "node scripts/ac-ats-enforce.mjs --dry-run",
    "ac:ats-matrix": "node scripts/ac-ats-matrix.mjs",
    "ac:wake-random": "node scripts/ac-wake-random-batch.mjs --clean",
    "ac:atriveo-random": "node scripts/ac-atriveo-random-batch.mjs --clean",
    "ac:routing-golden": "node scripts/ac-routing-golden.mjs",
    "ac:global-optimize": "node scripts/ac-global-optimize.mjs",
    "ac:rejection-audit": "node scripts/ac-rejection-audit.mjs",
    "ac:jd-soak": "node scripts/ac-jd-soak.mjs",
    "ac:ci": "node scripts/ac-ci-verify.mjs",
    "ac:replay": "node scripts/ac-fingerprint-replay.mjs",
    "ac:full-batch": "node scripts/ac-full-resume-batch.mjs --clean",
    "ac:simulate": "node scripts/ac-simulator.mjs",
    "ac:counterfactual": "node scripts/ac-counterfactual.mjs",
    "spotify:migrate": "python3 scripts/spotify_to_ytmusic.py",
    "jd:export": "node scripts/export-job-descriptions.mjs",
    "export:descriptions": "node scripts/export-job-descriptions.mjs",
    "pipeline:sync": "node scripts/export-job-descriptions.mjs",
    "pipeline:status": "node scripts/pipeline-status.mjs",
    "pipeline:install": "node scripts/install-pipeline-services.mjs",
    "pipeline:ready": "node scripts/pipeline-ready.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name atriveo-app",
    "feed:sync": "bash scripts/sync-job-feed.sh",
    "resume:sync": "bash scripts/sync-resume-queue.sh",
    "sync:all": "bash scripts/post-pipeline-deploy.sh",
    "data:deploy": "npm run feed:sync",
    "dev:full": "wrangler pages dev dist --compatibility-date=2024-01-01",
    "sync:logos": "node scripts/sync-company-domains.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "jose": "^6.2.2",
    "js-yaml": "^4.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260409.1",
    "@emnapi/core": "^1.9.2",
    "@emnapi/runtime": "^1.9.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "mongodb": "^7.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wrangler": "^4.81.1"
  }
}
